{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions valid on every platform, for the main window and the hidden PDF-export print window. The pdf-print-* glob matches nothing on iOS, where there is no second window.",
  "windows": ["main", "pdf-print-*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:app:default",
    "core:resources:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "shell:allow-open",
    "os:default",
    "os:allow-platform"
  ]
}
