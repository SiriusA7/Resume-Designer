# Dependencies
node_modules/

# Build outputs
dist/
release/

# Tauri / Rust
src-tauri/target/
# `gen/` is generated output EXCEPT for the Apple project: the SwiftUI shell
# lives in that Xcode project, so it is committed source and `tauri ios init`
# is a change we review rather than accept. Its own
# `src-tauri/gen/apple/.gitignore` still excludes build/, Externals/ and
# xcuserdata/. See docs/ios/xcode-project-ownership.md.
src-tauri/gen/*
!src-tauri/gen/apple

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
logs/
*.log
npm-debug.log*

# OS files
Thumbs.db
